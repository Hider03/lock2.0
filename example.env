# .env.example

# --------------------------
# --- Security & JWT Settings ---
# --------------------------
# The SECRET_KEY must be a long, random, and unique string.
SECRET_KEY="your_super_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --------------------------
# --- Email/SMTP Settings ---
# --------------------------
# These settings will work for most generic SMTP providers (e.g., SendGrid, Mailgun, Outlook/Microsoft 365, etc.)

# The username used to authenticate with the SMTP server.
MAIL_USERNAME="YOUR_SMTP_USERNAME"
# The password or access key/token for the account.
MAIL_PASSWORD=
# The "from" email address your users will see.
MAIL_FROM="noreply@yourappdomain.com"
# The address of the mail server.
MAIL_SERVER="smtp.example.com"
# The port is often 587 (TLS) or 465 (SSL).
MAIL_PORT=587
# Use True for most modern servers (Standard for port 587).
MAIL_STARTTLS=True
# Use False when using STARTTLS (Standard for port 587).
# Use True and change the port to 465 if you must use implicit SSL/TLS.
MAIL_SSL_TLS=False